{
  "name": "weather-wardrobe",
  "private": true,
  "version": "0.1.0",
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-query": "5.104.2",
    "knex": "3.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "react-hook-form": "7.90.0",
    "@hookform/resolvers": "5.9.1",
    "openai": "7.32.0",
    "sharp": "0.35.5",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "class-variance-authority": "0.7.1",
    "@radix-ui/react-slot": "1.5.0",
    "lucide-react": "1.56.0",
    "@next/env": "16.4.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "shadcn": "4.21.4",
    "vitest": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@playwright/test": "1.64.0",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "jsdom": "30.1.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "postcss": "8.5.29",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "packageManager": "pnpm@12.11.2",
  "description": "Local weather wardrobe with an isolated portfolio demo",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src tests db *.ts *.mts *.mjs --no-warn-ignored",
    "test": "vitest run tests/unit tests/components",
    "test:coverage": "tsx src/server/tools/test.ts --coverage",
    "test:integration": "tsx src/server/tools/test.ts --integration",
    "test:e2e": "pnpm build && playwright test",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:stop": "docker compose --env-file .env.local stop",
    "db:migrate": "tsx src/server/tools/migrate.ts",
    "test:persistence": "tsx tests/integration/persistence-check.ts",
    "format": "prettier --write \"src/**/*.tsx\" \"src/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.tsx\" \"src/**/*.css\""
  }
}
