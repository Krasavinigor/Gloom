# Copy to .env.local; keep actual credentials out of git.
# Demo starts without DATABASE_URL or OPENAI_API_KEY.
ENABLE_AI=false
OPENAI_API_KEY=

POSTGRES_USER=wardrobe
POSTGRES_DB=wardrobe
POSTGRES_PORT=55432
# Generate a random password locally, then use the same value in DATABASE_URL.
POSTGRES_PASSWORD=
# Example shape: postgresql://wardrobe:<URL-encoded-password>@127.0.0.1:55432/wardrobe
DATABASE_URL=
FILE_STORAGE_ROOT=.data/photos

# Explicit opt-in for integration tests. A random isolated schema is created
# and removed; do not point this at a production database.
INTEGRATION_DATABASE_URL=
